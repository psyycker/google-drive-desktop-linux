{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Google Drive sync for Linux",
    "longDescription": "Mirrors your whole Google Drive into a local folder and keeps both sides in sync, with a tray icon and status window.",
    "externalBin": ["binaries/gdrived", "binaries/gdrive"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "net",
        "files": {
          "/usr/share/mime/packages/gdrive-linux.xml": "../../packaging/gdrive-linux-mime.xml",
          "/usr/share/applications/gdrive-open.desktop": "../../packaging/gdrive-open.desktop",
          "/usr/lib/systemd/user/gdrived.service": "../../packaging/gdrived-system.service"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/mime/packages/gdrive-linux.xml": "../../packaging/gdrive-linux-mime.xml",
          "/usr/share/applications/gdrive-open.desktop": "../../packaging/gdrive-open.desktop",
          "/usr/lib/systemd/user/gdrived.service": "../../packaging/gdrived-system.service"
        }
      }
    }
  }
}
