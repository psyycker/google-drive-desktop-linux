[Unit]
Description=gdrive-linux Google Drive sync daemon
Documentation=file://%h/.local/share/doc/gdrive-linux/README.md
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gdrived
Restart=on-failure
RestartSec=5
# Let systemd stop us gracefully so in-flight DB writes finish.
KillSignal=SIGTERM
TimeoutStopSec=20
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
